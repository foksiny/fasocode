# ---------- Node / npm ----------
node_modules/
package-lock.json.bak

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Build output ----------
dist/
dist-ssr/
*.local

# Local env files (NOT committed; keep .env templates if any)
.env
.env.local
.env.*.local

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- Vite cache ----------
.vite/

# ---------- Tauri ----------
# Build artifacts and generated code live under src-tauri; keep the entries
# here as a safety net in case the nested .gitignore is ever removed.
src-tauri/target/
src-tauri/gen/schemas/

# Tauri platform-specific build/output dirs
src-tauri/WixTools/
src-tauri/.tauri/

# ---------- Rust ----------
**/*.rs.bk

# ---------- Tests / coverage ----------
coverage/
.nyc_output/

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.fleet/

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- Misc ----------
.cache/
*.pem
